package com.example.dualgauge

import android.content.Context
import android.graphics.Canvas
import android.graphics.Color
import android.graphics.Paint
import android.graphics.RectF
import android.graphics.Typeface
import android.util.AttributeSet
import android.view.View
import kotlin.math.cos
import kotlin.math.roundToInt
import kotlin.math.sin

class AnalogGaugeView @JvmOverloads constructor(
    context: Context,
    attrs: AttributeSet? = null,
    defStyleAttr: Int = 0,
) : View(context, attrs, defStyleAttr) {

    private val cyan = Color.parseColor("#5ED9FF")
    private val cyanSoft = Color.parseColor("#D8F5FF")
    private val dark = Color.parseColor("#07151D")
    private val red = Color.parseColor("#FF4D4D")
    private val darkPanel = Color.parseColor("#0E2C39")

    private var currentValue = 0f
    private var maximumValue = 140f
    private var scaleMax = 140f
    private var warningLimit = 120f
    private var unitLabel = "km/h"
    private val arcRect = RectF()

    private val darkPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = dark
        style = Paint.Style.FILL
    }

    private val glowPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        style = Paint.Style.STROKE
        strokeWidth = 12f
        color = cyan
        setShadowLayer(18f, 0f, 0f, cyan)
    }

    private val innerArcPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        style = Paint.Style.STROKE
        strokeWidth = 4f
        color = cyan
        alpha = 170
    }

    private val tickPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        style = Paint.Style.STROKE
        strokeWidth = 2.5f
        strokeCap = Paint.Cap.ROUND
        color = cyan
    }

    private val tickMajorPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        style = Paint.Style.STROKE
        strokeWidth = 4f
        strokeCap = Paint.Cap.ROUND
        color = cyan
    }

    private val valueTextPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = Color.WHITE
        textAlign = Paint.Align.CENTER
        typeface = Typeface.DEFAULT_BOLD
        textSize = 76f
    }

    private val unitTextPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = cyanSoft
        textAlign = Paint.Align.CENTER
        typeface = Typeface.SANS_SERIF
        textSize = 38f
    }

    private val scaleTextPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = cyanSoft
        textAlign = Paint.Align.CENTER
        typeface = Typeface.SANS_SERIF
        textSize = 28f
    }

    private val badgePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = red
        style = Paint.Style.FILL
    }

    private val badgeTextPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = Color.WHITE
        textAlign = Paint.Align.CENTER
        typeface = Typeface.DEFAULT_BOLD
        textSize = 30f
    }

    fun setValue(value: Float) {
        currentValue = value.coerceIn(0f, maximumValue)
        invalidate()
    }

    fun setMaximumValue(value: Float) {
        maximumValue = value.coerceAtLeast(1f)
        currentValue = currentValue.coerceIn(0f, maximumValue)
        invalidate()
    }

    fun setScaleMax(value: Float) {
        scaleMax = value.coerceAtLeast(1f)
        invalidate()
    }

    fun setWarningLimit(value: Float) {
        warningLimit = value
        invalidate()
    }

    fun setUnitLabel(value: String) {
        unitLabel = value
        invalidate()
    }

    override fun onDraw(canvas: Canvas) {
        super.onDraw(canvas)

        val w = width.toFloat()
        val h = height.toFloat()
        val cx = w / 2f
        val cy = h / 2f + 18f
        val radius = (minOf(w, h) * 0.9f) / 2f

        canvas.drawColor(Color.BLACK)

        val arcRadius = radius * 0.92f
        arcRect.set(cx - arcRadius, cy - arcRadius, cx + arcRadius, cy + arcRadius)

        canvas.drawArc(arcRect, 150f, 240f, false, glowPaint)
        canvas.drawArc(arcRect, 150f, 240f, false, innerArcPaint)

        val startAngle = 150f
        val sweepAngle = 240f
        val maxLimit = if (unitLabel == "RPM") 10f else scaleMax
        val majorStep = if (unitLabel == "RPM") 2f else 20f

        for (i in 0..(maxLimit * 10).toInt()) {
            val ratio = i / (maxLimit * 10f)
            val angle = startAngle + sweepAngle * ratio
            val rad = Math.toRadians(angle.toDouble())
            val innerR = arcRadius - 28f
            val outerR = arcRadius + 2f

            val x1 = cx + cos(rad) * innerR
            val y1 = cy + sin(rad) * innerR
            val x2 = cx + cos(rad) * outerR
            val y2 = cy + sin(rad) * outerR

            val major = when (unitLabel) {
                "RPM" -> i % 20 == 0
                else -> i % 10 == 0
            }

            val localPaint = if (major) tickMajorPaint else tickPaint
            localPaint.strokeWidth = if (major) 4f else 2.5f
            localPaint.color = if (i <= (warningLimit / maximumValue) * (maxLimit * 10f).toInt()) cyan else red

            canvas.drawLine(x1.toFloat(), y1.toFloat(), x2.toFloat(), y2.toFloat(), localPaint)
        }

        val labelStep = if (unitLabel == "RPM") 2f else 20f
        val labelMax = if (unitLabel == "RPM") 10f else scaleMax
        for (i in 0..(labelMax / labelStep).toInt()) {
            val value = i * labelStep
            val ratio = value / scaleMax
            val angle = startAngle + sweepAngle * ratio
            val rad = Math.toRadians(angle.toDouble())
            val labelR = arcRadius * 0.74f
            val lx = cx + cos(rad) * labelR
            val ly = cy + sin(rad) * labelR + 12f

            scaleTextPaint.color = cyanSoft
            canvas.drawText(value.toString(), lx.toFloat(), ly.toFloat(), scaleTextPaint)
        }

        val ratio = (currentValue / maximumValue).coerceIn(0f, 1f)
        val angle = startAngle + sweepAngle * ratio
        val needleLen = arcRadius * 0.72f
        val needleRad = Math.toRadians(angle.toDouble())
        val needleX = cx + cos(needleRad) * needleLen
        val needleY = cy + sin(needleRad) * needleLen

        val needlePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = Color.WHITE
            style = Paint.Style.STROKE
            strokeWidth = 6f
            strokeCap = Paint.Cap.ROUND
        }
        canvas.drawLine(cx, cy, needleX.toFloat(), needleY.toFloat(), needlePaint)

        val centerRadius = arcRadius * 0.66f
        canvas.drawCircle(cx, cy, centerRadius, darkPaint)

        val displayValue = if (unitLabel == "RPM") {
            currentValue.roundToInt().toString()
        } else {
            currentValue.roundToInt().toString()
        }
        valueTextPaint.textSize = if (unitLabel == "RPM") 70f else 90f
        canvas.drawText(displayValue, cx, cy + 26f, valueTextPaint)

        unitTextPaint.textSize = if (unitLabel == "RPM") 30f else 42f
        canvas.drawText(unitLabel, cx, cy + 74f, unitTextPaint)

        val badgeRadius = 48f
        val badgeCx = cx + arcRadius * 0.83f
        val badgeCy = cy + arcRadius * 0.46f
        canvas.drawCircle(badgeCx, badgeCy, badgeRadius, badgePaint)
        badgeTextPaint.textSize = 30f
        canvas.drawText(scaleMax.roundToInt().toString(), badgeCx, badgeCy + 10f, badgeTextPaint)
    }
}
